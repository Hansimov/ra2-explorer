{
  "name": "ra2-explorer-demo-video",
  "private": true,
  "version": "0.15.0",
  "description": "RA2 Explorer reusable showcase recording and QA pipeline",
  "scripts": {
    "audio:inspect": "node inspect-audio-devices.cjs",
    "audio:verify": "node verify-cable-route.cjs",
    "record": "node record-showcase.cjs",
    "voices:plan": "node plan-soviet-voices.cjs --profile=soviet",
    "voices:audit": "node audit-voice-plan.cjs soviet-voices-plan.json --strict",
    "voices:animations:inspect": "node inspect-animation-data.cjs",
    "voices:animations:test": "node test-voice-animation-planner.cjs",
    "voices:record": "node record-soviet-voices.cjs --profile=soviet",
    "voices:render": "node render-soviet-voices.cjs --profile=soviet",
    "voices:qa": "node qa-soviet-voices.cjs --profile=soviet",
    "allied-voices:plan": "node plan-soviet-voices.cjs --profile=allied",
    "allied-voices:audit": "node audit-voice-plan.cjs allied-voices-plan.json --strict",
    "allied-voices:record": "node record-soviet-voices.cjs --profile=allied",
    "allied-voices:render": "node render-soviet-voices.cjs --profile=allied",
    "allied-voices:qa": "node qa-soviet-voices.cjs --profile=allied",
    "assemble": "node assemble-showcase.cjs",
    "render": "node render-showcase.cjs",
    "qa": "node qa-showcase.cjs"
  },
  "dependencies": {
    "playwright": "1.48.2"
  }
}
